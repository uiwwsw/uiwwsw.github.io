{
  "name": "uiwwsw-github-io",
  "private": true,
  "type": "module",
  "version": "1.0.1",
  "description": "A lunar journey through uiwwsw's writing universe",
  "scripts": {
    "dev": "vite",
    "test": "node --test tests/*.test.js",
    "fetch-data": "node scripts/fetch-velog.js",
    "refresh-content": "npm run fetch-data",
    "build": "npm run build:app",
    "build:app": "vite build && npm run version-dist",
    "build:full": "npm run refresh-content && npm run build:app",
    "version-dist": "node scripts/update-cache-version.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-three/drei": "9.105.5",
    "@react-three/fiber": "8.16.7",
    "@react-three/postprocessing": "2.15.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.160.1",
    "undici": "^7.18.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "cheerio": "^1.1.2",
    "rss-parser": "^3.13.0",
    "terser": "^5.44.1",
    "vite": "^5.4.1"
  }
}
